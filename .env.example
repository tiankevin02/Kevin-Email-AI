PORT=8787
HOST=127.0.0.1

# Google Cloud OAuth client for a Desktop/Web app.
# Redirect URI: http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI API keys. At least one is required for AI features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternatives (any one of these also works)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
